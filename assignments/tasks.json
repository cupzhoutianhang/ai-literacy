    {
      "id": "A03",
      "title": "设计只读工具调用并计算泵功率",
      "lessons": [
        5,
        6,
        7
      ],
      "minutes": 40,
      "version": 1,
      "published": true,
      "deadline": null,
      "brief": "根据模拟仪表数据安排工具调用顺序，完成压差、流量与液压功率计算。",
      "instructions": [
        "把 sensors.csv 和 tools.md 交给豆包工作，生成工具调用方案并计算结果。",
        "泵压升 = 出口压力 - 入口压力；液压功率 W = 压升 Pa × 流量 m³/s，不引入效率修正。delta_p_kpa 字段表示泵压升。",
        "计划按 read_sensor → calculate_delta_p → calculate_power 排列，只做只读演示，不控制设备。",
        "至少手算一组数据核对单位，提交两台泵的结果。"
      ],
      "attachments": [
        {
          "name": "sensors.csv",
          "path": "a03/sensors.csv"
        },
        {
          "name": "tools.md",
          "path": "a03/tools.md"
        }
      ],
      "template": "a03/answer-template.json",
      "rubric": [
        {
          "label": "P01 压差",
          "path": "results.P01.delta_p_kpa",
          "expected": 60,
          "points": 10
        },
        {
          "label": "P01 流量换算",
          "path": "results.P01.flow_m3_s",
          "expected": 0.0033333333333333335,
          "points": 10,
          "tolerance": 1e-05
        },
        {
          "label": "P01 液压功率",
          "path": "results.P01.power_w",
          "expected": 200,
          "points": 10
        },
        {
          "label": "P02 压差",
          "path": "results.P02.delta_p_kpa",
          "expected": 40,
          "points": 10
        },
        {
          "label": "P02 流量换算",
          "path": "results.P02.flow_m3_s",
          "expected": 0.005,
          "points": 10,
          "tolerance": 1e-05
        },
        {
          "label": "P02 液压功率",
          "path": "results.P02.power_w",
          "expected": 200,
          "points": 10
        },
        {
          "label": "调用顺序",
          "path": "plan",
          "expected": [
            "read_sensor",
            "calculate_delta_p",
            "calculate_power"
          ],
          "points": 10
        },
        {
          "label": "只读边界",
          "path": "write_enabled",
          "expected": false,
          "points": 10
        }
      ],
      "process_points": 20
